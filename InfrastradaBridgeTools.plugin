  "contexts": {
    "ctx_mkitem": {
      "items": [
        "id_СreateNewModelBridge \"%0\""
      ]
    },
    "bridge.context": {
      "priority": 1001,
      "items": [
        { "default": "$(if,$(opened,%0),core.id_close \"%0\" \"Скрыть модель\",core.id_open \"%0\" \"Показать модель\")" },
        "id_EditModelBridge \"%0\"",
        "-",
        "core.id_rmitem \"%0\""
      ]
    }
  },
  "cores": {
    "bridge": {
      "title": "$(referencename,%0)",
      "description": "Мостовое сооружение %0",
      "icon": "infrastrada_ModelBridge1_32dp_1x",
      "statusicon": "",
      "flags": "$(modelflags,%0)",
      "menu": "bridge.context \"%0\""
    }
  },
